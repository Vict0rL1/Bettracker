# Copy this file to `.env` and fill in the two values from your Supabase project:
# its URL (https://<ref>.supabase.co) and its publishable key (sb_publishable_…,
# under Project Settings -> API Keys). The old anon key (eyJ…) works too, until
# Supabase retires the legacy keys at the end of 2026. Both are safe to ship in
# a client app: they only grant what your row-level security policies allow.
# Never the secret key (sb_secret_… or service_role): the build refuses it.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
